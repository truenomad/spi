    orcid: "https://orcid.org/0000-0002-9339-4613"
license: MIT
repository-code: "https://github.com/truenomad/blindspot"
url: "https://truenomad.github.io/blindspot/"
date-released: "2026-07-02"
keywords:
  - polio
  - AFP
  - surveillance
  - epidemiology
  - BYM2
  - INLA
  - "r-package"
